<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Contact - Garage V.Parrot</title>
        <link rel="stylesheet" href="{{ asset('styles/contact.css') }}">
    </head>

    <body>
        <!-- Header -->
        <header>
            <div class="header-container">
                <nav class="navbar">
                    <div class="div_tel">
                        <img class="icone_tel" src="{{ asset('images/icone_tel.png') }}" alt="Garage Auto">
                        <p class="texte_tel">Tel : 01 - 40 - 56 - 89 - 78</p>
                    </div>

                    <div class="div_adresse">
                        <img class="icone_adresse" src="{{ asset('images/icone_localisation.png') }}" alt="Garage Auto">
                        <p class="texte_adresse">123 Rue de l'Aube 75012 Paris</p>
                    </div>

                    <div class="div_email">
                        <img class="icone_email" src="{{ asset('images/icone_email.png') }}" alt="Garage Auto">
                        <p class="texte_email">e-mail : Contact-garagevp@gmail.com</p>
                    </div>
                </nav>

                <ul class="menu">
                    <img class="logo" src="{{ asset('images/logo.png') }}" alt="Garage Auto">
                    <li class="item"><a href="{{ path('app_home') }}">Accueil</a></li>
                    <p class="separation">|</p>
                    <li class="item"><a href="{{ path('app_nos_services') }}">Découvrez nos services</a></li>
                    <p class="separation">|</p>
                    <li class="item"><a href="{{ path('app_login') }}">Connexion</a></li>
                    <p class="separation">|</p>
                    <li class="item"><a href="{{ path('app_contact') }}">Contact</a></li>
                </ul>
            </div>
        </header>

        <main>
            <section class="contact-section">
                <img class="img_supercar_contact" src="{{ asset('images/supercar_contact.png') }}" alt="supercar">
                <div class="container">
                    <form id="contact-form" class="contact-form">
                        <div class="form-group">
                            <label for="nom">Nom</label>
                            <input 
                                type="text" 
                                id="nom" 
                                name="nom" 
                                required 
                                class="form-control"
                                placeholder="Votre nom"
                            >
                        </div>

                        <div class="form-group">
                            <label for="prenom">Prénom</label>
                            <input 
                                type="text" 
                                id="prenom" 
                                name="prenom" 
                                class="form-control"
                                placeholder="Votre prénom"
                            >
                        </div>

                        <div class="form-group">
                            <label for="email">Email</label>
                            <input 
                                type="email" 
                                id="email" 
                                name="email" 
                                required 
                                class="form-control"
                                placeholder="Votre email"
                            >
                        </div>

                        <div class="form-group">
                            <label for="objet">Objet</label>
                            <input 
                                type="text" 
                                id="objet" 
                                name="objet" 
                                class="form-control"
                                placeholder="Objet de votre message"
                            >
                        </div>

                        <div class="form-group">
                            <label for="message">Message</label>
                            <textarea 
                                id="message" 
                                name="message" 
                                required 
                                class="form-control"
                                rows="5"
                                placeholder="Votre message"
                            ></textarea>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn-submit">
                                Envoyer
                            </button>
                        </div>
                    </form>

                    <!-- Message de succès -->
                    <div id="success-message" class="success-message hidden">
                        <div class="success-content">
                            <h3>Message envoyé avec succès !</h3>
                            <p>Nous vous répondrons dans les plus brefs délais.</p>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        
                <footer>
                
                    <div class="full-footer">
                        <div class="footer-info-garage">
                            <img class="logo_footer" src="{{ asset('images/logo.png') }}" alt="Garage Auto">
                            <div class="footer-a_propos">
                                <h2>A propos</h2>
                                <div class="icone_adresse">
                                    <img class="icone_adresse_footer" src="{{ asset('images/icone_localisation.png') }}" alt="Garage Auto"><p>123 Rue de l'Aube - 31400 TOULOUSE</p>
                                </div>
                                <div class="icone_telephone">
                                    <img class="icone_telephone_footer" src="{{ asset('images/icone_tel.png') }}" alt="Garage Auto"><p class="num_tel">01 23 45 67 89</p>
                                </div>
                                <div class="icone-email">
                                    <img class="icone_email_footer" src="{{ asset('images/icone_email.png') }}" alt="Garage Auto"><p class="email">contact@garagevp.fr</p>
                                </div>
                            </div>
                            <div class="footer-horaires">
                                <h2>Horaires</h2>
                                <p>Lundi au vendredi</p>
                                <p>de 8h a 21h</p>
                                <p>samedi de 9h a 19h</p>
                            </div>
                        </div>    
                            <div class="footer-media">
                                <img class="icone_fb" src="{{ asset('images/icone_fb.png') }}" alt="Garage Auto">
                                <img class="icone_twitter" src="{{ asset('images/icone_twitter.png') }}" alt="Garage Auto">
                                <img class="icone_insta" class src="{{ asset('images/icone_insta.png') }}" alt="Garage Auto">
                            </div>
                            <hr class="trait-footer">
                        <div class="footer-legal">
                            <p class="mention"><a href="{{ path('app_mention_legale') }}">Mentions légales</a></p>
                            <p class="politique"><a href="{{ path('app_politique_de_confidentialite') }}">Politique de confidentialité</a></p>
                            <p class="condition"><a href="{{ path('app_conditions_utilisation') }}">Condition d'utilisation</a></p>
                        </div>
                    </div>
            </footer>
        <!-- Scripts Firebase -->
        <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
        <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-firestore.js"></script>
        <script src="{{ asset('js/firebase-config.js') }}"></script>
        <script src="{{ asset('js/contact.js') }}"></script>
    </body>
</html>
