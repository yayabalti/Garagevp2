{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}garagevp{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('styles/index.css') }}">
    </head>

    <body>
        <!-- Header -->
        {% block header %}
        <header>
        
            <div class="header-container">
            
                <div class="logo">
                    
                </div>
                <nav class="navbar">

                    <div class="div_tel">
                        <img class="icone_tel" src="{{ asset('images/icone_tel.png') }}" alt="Garage Auto">
                        <p class="texte_tel">01 - 40 - 56 - 89 - 78<p/>
                    </div>

                    <div class="div_adresse">
                        <img class="icone_adresse" src="{{ asset('images/icone_localisation.png') }}" alt="Garage Auto">
                        <p class="texte_adresse">123 Rue de l'Aube - 31400 TOULOUSE</p>
                    </div>

                    <div class="div_email">
                        <img class="icone_email" src="{{ asset('images/icone_email.png') }}" alt="Garage Auto">
                        <p class="texte_email">Contact-garagevp@gmail.com</p>
                    </div>
                </nav>

                    <ul class="menu">
                            <img class="logo" src="{{ asset('images/logo.png') }}" alt="Garage Auto">
                        <li class="item"><a href="{{ path('app_home') }}">Accueil</a></li>
                            <p class="separation">|</p>
                        <li class="item"><a href="{{ path('app_nos_services') }}">Découvrez nos services</a></li>
                            <p class="separation">|</p>
                        <li class="item"><a href="{{ path('app_login') }}">connexion</a></li>
                            <p class="separation">|</p>
                        <li class="item"><a href="{{ path('app_contact') }}">Contact</a></li>
                        {# boutton pour acceder a easy admin  #}
                        {% if is_granted('ROLE_ADMIN') %}
                        <div class="mt-4">
                         <a href="{{ path('admin_dashboard') }}" class="btn btn-primary"><i class="fas fa-cogs me-2"></i>Accès Admin</a>
                        </div>
                        {% endif %}
                             
                        {% if is_granted('ROLE_EMPLOYE') %}
                        <div class="mt-4">
                        <a href="{{ path('employee_dashboard')}}" class="btn btn-primary"><i class="fas fa-user-cog me-2"></i>Accès Employé</a>
                        </div>                   
                        {% endif %} 
                    </ul>
    
                        
                
            </div>
            
        </header>
       {% endblock %}

        <main>
            
            <section class="hero">
                <img class="skyline_img" src="{{ asset('images/imgheader.png') }}" alt="Garage Auto" >
                <div class="opacity"></div>
                <div class="hero-content">
                    <img class="logo_main" src="{{ asset('images/logo.png') }}" alt="Garage Auto" >
                    <h2 class="titre_header">Votre expert automobile, de la vente à l'entretien</h2>
                </div>
            </section>

            

            <!-- Services -->
            <section id="services">
            <h2>Nos services</h2>
                <div class="container">
                    <div class="service">
                        <h3>Vente de Voitures d'Occasion</h3>
                        <img src="{{ asset('images/voiture.jpg') }}" alt="Voiture d'occasion">
                        <p>Découvrez notre sélection de voitures d'occasion.</p>
                        <a href="{{ path('app_home') }}" class="btn">Voir nos voitures</a>
                    </div>

                    <div class="service">
                        <h3>Mécanique</h3>
                        <img src="{{ asset('images/mecanique.jpg') }}" alt="Mécanique">
                        <p>Des services de mécanique complets pour votre véhicule.</p>
                        <a href="{{ path('app_home') }}" class="btn">En savoir plus</a>
                    </div>

                     <div class="service">
                        <h3>Entretien</h3>
                        <img src="{{ asset('images/mecanique.jpg') }}" alt="Mécanique">
                        <p>Des services d'entretien complets pour votre véhicule.</p>
                        <a href="{{ path('app_home') }}" class="btn">En savoir plus</a>
                    </div>

                    <div class="service">
                        <h3>Carrosserie</h3>
                        <img src="{{ asset('images/carrosserie.jpg') }}" alt="Carrosserie">
                        <p>Réparations et rénovations de qualité pour votre carrosserie.</p>
                        <a href="{{ path('app_home') }}" class="btn">En savoir plus</a>
                    </div>
                </div>
            </section>

            <!-- choisir garage vp -->

            <section>
                <div class="full_div"> 
                    <h2>Choisir gagare v.p</h2>
                        
                        <div>
                            <img src="">
                            <p> </p>
                        </div>
                                
                        <div>
                            <img src="">
                            <p> </p>
                        </div>
                                
                        <div>
                            <img src="">
                            <p> </p>
                        </div>
                                
                        <div>
                            <img src="">
                            <p> </p>
                        </div>
                </div>
            </section>

            <!-- Formulaire de Contact -->
            <section id="contact-form">
                <div class="container">
                    <div class="contact-form">
                        <h3>Garage V.P est la solution contactez-nous !</h3>
                        <p>Nos horaires : du lundi au vendredi 8h - 20h,<br> samedi de 9h à 19h</p>
                        <form>
                            <label for="name">Nom :</label>
                            <input type="text" id="name" name="name" required>
                            <label for="email">Email :</label>
                            <input type="email" id="email" name="email" required>
                            <label for="message">Message :</label>
                            <textarea id="message" name="message" required></textarea>
                            <button type="submit" class="btn">Envoyer</button>
                        </form>
                    </div>
                </div>
            </section>

            <!-- Témoignages -->
            <section id="testimonials">
                <div class="container">
                    <h2>Avis de nos clients</h2>
                    <div class="carousel">
                        <div class="testimonial">
                            <p>"Excellent service, très professionnel!"</p>
                            <p>- Client Satisfait</p>
                        </div>
                        <!-- Ajoute plus de témoignages ici -->
                    </div>
                    <a href="{{ path('app_home') }}" class="btn">Qui sommes-nous ?</a> 
                </div>
            </section>

            <section class="">
                <div> 
                    <h1>Venez nous voir !</h1>
                    <h2>et reparter en toutes serenité</h2>

                    <div class="div_email">
                        <img src="">
                        <p></p>
                    </div>

                    <div class="div_adresse">
                        <img src="">
                        <p></p>
                    </div>

                    <div class="div_tel">
                        <img src="">
                        <p></p>
                    </div>
                </div>
            </section>
        </main>

        <!-- Footer -->
        {% block footer %}
        <footer>
            <div class="container">
                <div class="footer-content">
                    <div class="footer-logo">
                        <img src="{{ asset('images/logo.png') }}" alt="Garage Auto">
                    </div>
                    <div class="footer-info">
                        <p>Adresse : 123 Rue de l'Aube - 31400 TOULOUSE</p>
                        <p>Téléphone : 01 23 45 67 89</p>
                        <p>Email : contact@garagevp.fr</p>
                    </div>
                    <div class="footer-social-media">
                        <a href="#">Facebook</a>
                        <a href="#">Twitter</a>
                        <a href="#">Instagram</a>
                    </div>
                    
                    <div class="footer-legal">
                        <p><a href="{{ path('app_mention_legale') }}">Mentions légales</a></p>
                        <p><a href="{{ path('app_politique_de_confidentialite') }}">Politique de confidentialité</a></p>
                    </div>
                </div>
                </div>
            </div>
        </footer>
        {% endblock %}
    </body>
</html>




