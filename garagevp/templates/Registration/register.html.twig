{# templates/registration/register.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}formulaire_Inscription{% endblock %}

{% block body %}
<div class="container mt-5">
   <div class="row justify-content-center">
       <div class="col-md-6">
           <div class="card">
               <div class="card-header">
                   <h1 class="h3 mb-3 font-weight-normal">Inscription</h1>
               </div>
               <div class="card-body">
                   {{ form_start(registrationForm) }}
                       <div class="mb-3">
                           {{ form_row(registrationForm.email, {
                               'attr': {'class': 'form-control'},
                               'label': 'Email'
                           }) }}
                       </div>

                       <div class="mb-3">
                           {{ form_row(registrationForm.plainPassword, {
                               'attr': {
                                   'class': 'form-control',
                                   'pattern': '^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$'
                               },
                               'label': 'Mot de passe',
                               'help': 'Le mot de passe doit contenir au moins 8 caractères, une majuscule, une minuscule, un chiffre et un caractère spécial'
                           }) }}
                           {% if form_errors(registrationForm.plainPassword) %}
                               <div class="alert alert-danger">
                                   {{ form_errors(registrationForm.plainPassword) }}
                               </div>
                           {% endif %}
                       </div>

                       <div class="mb-3">
                           {{ form_row(registrationForm.roleUtilisateur, {
                               'attr': {'class': 'form-select'},
                               'label': 'Rôle',
                               'choices': {
                                   'Employé': 'employe',
                                   'Visiteur': 'visiteur'
                               }
                           }) }}
                       </div>

                       <div class="mb-3">
                           {{ form_row(registrationForm.agreeTerms, {
                               'attr': {'class': 'form-check-input'},
                               'label': 'J\'accepte les conditions'
                           }) }}
                       </div>

                       <button type="submit" class="btn btn-primary w-100">S'inscrire</button>
                   {{ form_end(registrationForm) }}
               </div>
           </div>
       </div>
   </div>
</div>
{% endblock %}