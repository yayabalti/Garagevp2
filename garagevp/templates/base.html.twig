<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Garage v.p{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('styles/styles.css') }}">
    {# Balises SEO #}
    <title>{% block title %}Garage V.P{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Réparations et entretiens de véhicules à Toulouse{% endblock %}">
    <meta name="keywords" content="{% block meta_keywords %}garage, réparation auto, entretien, mécanique, Toulouse{% endblock %}">
    
    {# Open Graph (Facebook & LinkedIn) #}
    <meta property="og:title" content="{% block og_title %}Garage V.P{% endblock %}">
    <meta property="og:description" content="{% block og_description %}Nous prenons soin de votre voiture avec expertise !{% endblock %}">
    <meta property="og:image" content="{% block og_image %}{{ asset('images/logo.png') }}{% endblock %}">
    <meta property="og:url" content="{{ app.request.uri }}">
    <meta property="og:type" content="website">

    {# Twitter Card #}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% block twitter_title %}Garage V.P{% endblock %}">
    <meta name="twitter:description" content="{% block twitter_description %}Experts en entretien et réparation automobile à Toulouse.{% endblock %}">
    <meta name="twitter:image" content="{% block twitter_image %}{{ asset('images/logo.png') }}{% endblock %}">
</head>
<body>
    <!-- Header -->
{% block header %}
    <header>
        
            <div class="header-container">
            
                <div class="logo">
                    <img src="{{ asset('images/logo.png') }}" alt="Garage Auto">
                </div>
                <nav>
                    <ul>
                        <li><a href="{{ path('app_home') }}">Accueil</a></li>
                        <p class="separation">|</p>
                        <li><a href="{{ path('app_nos_services') }}">Découvrez nos services</a></li>
                        <p class="separation">|</p>
                        <li><a href="{{ path('app_login') }}">Connexion</a></li>
                        <p class="separation">|</p>
                        <li><a href="{{ path('app_home') }}">Contact</a></li>
                    </ul>
                </nav>
            </div>
            
        </header>
{% endblock %}
    <main>
        
    </main>

    <!-- Footer -->
    {% block footer %}
    <footer>
        <div class="container">
            <div class="footer-content">
               
                    <div class="footer-logo">
                        <img src="{{ asset('images/logo.png') }}" alt="Garage Auto">
                    </div>
                    
                    <div class="footer-info">
                        <h2>A propos : </h2>
                        <p>123 Rue de l'Aube - 31400 TOULOUSE</p>
                        <p>01 23 45 67 89</p>
                        <p>contact@garagevp.fr</p>
                    </div>
                    <div class="footer-info">
                        <h2>Horaires</h2>
                        <p>Lundi au vendredi</p>
                        <p>de 8h a 21h</p>
                        <p>samedi de 9h a 19h</p>
                    </div>
               
                <div class="footer-social-media">
                    <img class="footer-logo" src="{{ asset('images/icone_instagram.png') }}" alt="icone insta">
                    <img class="footer-logo" src="{{ asset('images/icone_facebook.png') }}" alt="icone fb">
                    <img class="footer-logo" src="{{ asset('images/icone_youtube.png') }}" alt="icone youtube">
                </div>
                
                <div class="footer-legal">
                    <p><a href="{{ path('app_mention_legale') }}">Mentions légales</a></p>
                    <p><a href="{{ path('app_politique_de_confidentialite') }}">Politique de confidentialité</a></p>
                </div>
                
            </div>
        </div>
    </footer>
     {% endblock %}
</body>
</html>




