<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Garage v.p{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('styles/styles.css') }}">
    
</head>
<body>
    <!-- Header -->
{% block header %}
    <header>
        
            <div class="header-container">
            
                <div class="logo">
                    <img src="{{ asset('images/logo.png') }}" alt="Garage Auto">
                </div>
                <nav>
                    <ul>
                        <li><a href="{{ path('app_home') }}">Accueil</a></li>
                        <p class="separation">|</p>
                        <li><a href="{{ path('app_home') }}">Découvrez nos services</a></li>
                        <p class="separation">|</p>
                        <li><a href="{{ path('app_login') }}">Connexion</a></li>
                        <p class="separation">|</p>
                        <li><a href="{{ path('app_home') }}">Contact</a></li>
                        
                                   
                    
                
                                                  
                         
                    </ul>
                </nav>
            </div>
            
        </header>
        {% endblock %}
    <!-- Main Content -->
    <main>
        {% block content %}
        <!-- Le contenu spécifique aux pages sera inséré ici -->
        {% endblock %}
    </main>

    <!-- Footer -->
    {% block footer %}
    <footer>
        <div class="container">
            <div class="footer-content">
               
                    <div class="footer-logo">
                        <img src="{{ asset('images/logo.png') }}" alt="Garage Auto">
                    </div>
                    
                    <div class="footer-info">
                        <h2>A propos : </h2>
                        <p>123 Rue de l'Aube Toulouse 31400</p>
                        <p>01 23 45 67 89</p>
                        <p>contact@garagevp.fr</p>
                    </div>
                    <div class="footer-info">
                        <h2>Horaires</h2>
                        <p>Lundi au vendredi</p>
                        <p>de 8h a 21h</p>
                        <p>samedi de 9h a 19h</p>
                    </div>
               
                <div class="footer-social-media">
                    <img class="footer-logo" src="{{ asset('images/icone_instagram.png') }}" alt="icone insta">
                    <img class="footer-logo" src="{{ asset('images/icone_facebook.png') }}" alt="icone fb">
                    <img class="footer-logo" src="{{ asset('images/icone_youtube.png') }}" alt="icone youtube">
                </div>
                <div class="footer-legal">
                    <div class="footer-legal">
                        <p><a href="/mention-légale.html.twig">Mentions légales</a></p>
                        <p><a href="/politique_de.html.twig">Politique de confidentialité</a></p>
                    </div>
                </div>
            </div>
        </div>
    </footer>
{% endblock %}
</body>
</html>




