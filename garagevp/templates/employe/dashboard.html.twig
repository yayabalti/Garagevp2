{# templates/employe/dashboard.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Dashboard Employé{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="my-4">Dashboard Employé</h1>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h2 class="h5 mb-0">Voitures d'occasion</h2>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Marque</th>
                                    <th>Modèle</th>
                                    <th>Prix</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for voiture in voitures %}
                                    <tr>
                                        <td>{{ voiture.marque }}</td>
                                        <td>{{ voiture.model }}</td>
                                        <td>{{ voiture.prix }} €</td>
                                        <td>
                                            <a href="#" class="btn btn-sm btn-primary">Éditer</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h2 class="h5 mb-0">Avis Clients</h2>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Note</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for avis in avis %}
                                    <tr>
                                        <td>{{ avis.nom }} {{ avis.prenom }}</td>
                                        <td>{{ avis.note }}/5</td>
                                        <td>{{ avis.dateAvis|date('d/m/Y') }}</td>
                                        <td>
                                            <a href="#" class="btn btn-sm btn-primary">Gérer</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}