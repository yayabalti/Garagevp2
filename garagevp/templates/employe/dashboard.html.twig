{% extends '@EasyAdmin/page/content.html.twig' %}

{% block head %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/styles/dashbord_employe.css') }}">
{% endblock %}

{% block content %}
    <div class="employe-dashboard">
        <div class="dashboard-header">
           <h1>Gestion des Véhicules</h1>

           
            <div class="stats-cards">
                <div class="stat-card">
                   <i class="fas fa-car"></i>
                   <span class="stat-number">{{ cars|length }}</span>
                   <span class="stat-label">Voitures en stock</span>
                </div>
            </div>
        </div>

       <div class="car-grid">
            {% for car in cars %}
                <div class="car-card">
                    <div class="car-info">
                       <h3>{{ car.brand }} {{ car.model }}</h3>
                       <div class="car-details">
                           <span><i class="fas fa-calendar"></i> {{ car.year }}</span>
                           <span><i class="fas fa-gas-pump"></i> {{ car.engineType }}</span>
                           <span><i class="fas fa-road"></i> {{ car.mileage }} km</span>
                           <span><i class="fas fa-euro-sign"></i> {{ car.price|number_format(2, ',', ' ') }}</span>
                       </div>
                       <p class="car-description">{{ car.description|slice(0, 100) }}...</p>
                    </div>
                     <div class="car-image">
                        {% if car.image %}
                            {# Gestion des différents formats de chemins #}
                            {% set imagePath = car.image starts with 'uploads/' ? car.image : 'uploads/' ~ car.image %}
                            
                            <img style="width: 60vh;" src="{{ asset(imagePath) }}" alt="{{ car.brand }} {{ car.model }}">
                        {% else %}
                            <img src="{{ asset('uploads/default-car.jpg') }}" alt="Image par défaut">
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
{% endblock %}
















