<!DOCTYPE html>
<html lang="fr">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>{% block title %}connexion{% endblock %}</title>
            <link rel="stylesheet" href="{{ asset('css/login.css') }}">
        </head>

    <body>
        {% block header %}
        <header>

            <div class="header-container">

                <div class="logo">

                </div>
                <nav class="navbar">

                    <div class="div_tel">
                        <img class="icone_tel" src="{{ asset('images/icone_tel.png') }}" alt="Garage Auto">
                        <p class="texte_tel">01 - 40 - 56 - 89 - 78<p/>
                    </div>

                    <div class="div_adresse">
                        <img class="icone_adresse" src="{{ asset('images/icone_localisation.png') }}" alt="Garage Auto">
                        <p class="texte_adresse">123 Rue de l'Aube - 31400 TOULOUSE</p>
                    </div>

                    <div class="div_email">
                        <img class="icone_email" src="{{ asset('images/icone_email.png') }}" alt="Garage Auto">
                        <p class="texte_email"> Contact-garagevp@gmail.com</p>
                    </div>
                </nav>

                    <ul class="menu">
                            <img class="logo" src="{{ asset('images/logo.png') }}" alt="Garage Auto">
                        <li class="item"><a class="titre_menu_nav" href="{{ path('app_home') }}">Accueil</a></li>
                            <p class="separation">|</p>
                        <li class="item"><a class="titre_menu_nav" href="{{ path('app_nos_services') }}">Découvrez nos services</a></li>
                            <p class="separation">|</p>
                        <li class="item"><a class="titre_menu_nav" href="{{ path('app_contact') }}">Contact</a></li>
                    </ul> 
            </div>

        </header>
        {% endblock %}

        
        <main>
            <img class="img_connexion" src="{{ asset('images/img_connexion.jpg') }}" alt="Garage Auto">
            <div class="opacity_connexion"></div>
            <div class="login-container">
            
                <h2>Connexion</h2>

                {# Affichage des messages flash d'erreur génériques #}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">
                {{ message }}
            </div>
        {% endfor %}

        {# Affichage de l'erreur spécifique de la connexion #}
        {% if error %}
            <div class="alert alert-danger">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" class="login-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group">
                <label for="_username">Email:</label>
                <input type="email" 
                    id="email" 
                    name="email" 
                    value="{{ last_username }}" 
                    required 
                    autofocus 
                    pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"
                    class="form-control">
            </div>

            <div class="form-group">
                <label for="_password">Mot de passe:</label>
                <input type="password" 
                    id="password" 
                    name="password" 
                    required 
                    class="form-control">
            </div>
            
            <button type="submit" class="btn-login">Se connecter</button>
        </form>
            </div>
        </main>
        
           <!-- footer -->
           {% block footer %}
                <footer>
                
                    <div class="full-footer">
                        <div class="footer-info-garage">
                            <img class="logo_footer" src="{{ asset('images/logo.png') }}" alt="Garage Auto">
                            <div class="footer-a_propos">
                                <h2>A propos</h2>
                                <div class="icone_adresse">
                                    <img class="icone_adresse_footer" src="{{ asset('images/icone_localisation.png') }}" alt="Garage Auto"><p>123 Rue de l'Aube - 31400 TOULOUSE</p>
                                </div>
                                <div class="icone_telephone">
                                    <img class="icone_telephone_footer" src="{{ asset('images/icone_tel.png') }}" alt="Garage Auto"><p class="num_tel">01 23 45 67 89</p>
                                </div>
                                <div class="icone-email">
                                    <img class="icone_email_footer" src="{{ asset('images/icone_email.png') }}" alt="Garage Auto"><p class="email">contact@garagevp.fr</p>
                                </div>
                            </div>
                            <div class="footer-horaires">
                                <h2>Horaires</h2>
                                <p>Lundi au vendredi</p>
                                <p>de 8h a 21h</p>
                                <p>samedi de 9h a 19h</p>
                            </div>
                            <div class="footer-media">
                                <img class="icone_fb" src="{{ asset('images/icone_fb.png') }}" alt="Garage Auto">
                                <img class="icone_twitter" src="{{ asset('images/icone_twitter.png') }}" alt="Garage Auto">
                                <img class="icone_insta" class src="{{ asset('images/icone_insta.png') }}" alt="Garage Auto">
                            </div>
                        </div>    
                            
                            <hr class="trait-footer">
                        <div class="footer-legal">
                            <p class="mention"><a href="{{ path('app_mention_legale') }}">Mentions légales</a></p>
                            <p class="politique"><a href="{{ path('app_politique_de_confidentialite') }}">Politique de confidentialité</a></p>
                            <p class="condition"><a href="{{ path('app_conditions_utilisation') }}">Condition d'utilisation</a></p>
                        </div>
                    </div>
            </footer>
        {% endblock %}  
    </body>
</html>
