<!DOCTYPE html>
<html lang="fr">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>{% block title %}connexion{% endblock %}</title>
            <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
        </head>

    <body>
        {% block header %}
        <header>

            <div class="header-container">

                <div class="logo">

                </div>
                <nav class="navbar">

                    <div class="div_tel">
                        <img class="icone_tel" src="{{ asset('images/icone_tel.png') }}" alt="Garage Auto">
                        <p class="texte_tel">01 - 40 - 56 - 89 - 78<p/>
                    </div>

                    <div class="div_adresse">
                        <img class="icone_adresse" src="{{ asset('images/icone_localisation.png') }}" alt="Garage Auto">
                        <p class="texte_adresse">123 Rue de l'Aube - 31400 TOULOUSE</p>
                    </div>

                    <div class="div_email">
                        <img class="icone_email" src="{{ asset('images/icone_email.png') }}" alt="Garage Auto">
                        <p class="texte_email"> Contact-garagevp@gmail.com</p>
                    </div>
                </nav>

                    <ul class="menu">
                            <img class="logo" src="{{ asset('images/logo.png') }}" alt="Garage Auto">
                        <li class="item"><a class="titre_menu_nav" href="{{ path('app_home') }}">Accueil</a></li>
                            <p class="separation">|</p>
                        <li class="item"><a class="titre_menu_nav" href="{{ path('app_nos_services') }}">Découvrez nos services</a></li>
                            <p class="separation">|</p>
                        <li class="item"><a class="titre_menu_nav" href="{{ path('app_login') }}">connexion</a></li>
                            <p class="separation">|</p>
                        <li class="item"><a class="titre_menu_nav" href="{{ path('app_home') }}">Contact</a></li>
                        
            </div>

        </header>
        {% endblock %}

        
        <main>
            <img class="img_connexion" src="{{ asset('images/img_connexion.jpg') }}" alt="Garage Auto">
            <div class="opacity_connexion"></div>
            <div class="login-container">
            
                <h2>Connexion</h2>

                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post" class="login-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="form-group">
                        <label for="email">Email:</label>
                        <input type="email" 
                            id="email" 
                            name="email" 
                            value="{{ last_username }}" 
                            required 
                            autofocus 
                            pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"
                            class="form-control">
                    </div>

                    <div class="form-group">
                        <label for="password">Mot de passe:</label>
                        <input type="password" 
                            id="password" 
                            name="password" 
                            required 
                            class="form-control">
                    </div>
                    <button type="submit" class="btn-login">Se connecter</button>
                </form>
            </div>
        </main>
        
           <!-- footer -->

            {% block footer %}
            <footer>
            <div class="container">
                <div class="footer-content">
                    <div class="footer-logo">
                        <img src="{{ asset('images/logo.png') }}" alt="Garage Auto">
                    </div>
                    <div class="footer-info">
                        <p>123 Rue de l'Aube - 31400 TOULOUSE</p>
                        <p>01 23 45 67 89</p>
                        <p>contact@garagevp.fr</p>
                    </div>
                    <div class="footer-social-media">
                        <a href="#">Facebook</a>
                        <a href="#">Twitter</a>
                        <a href="#">Instagram</a>
                    </div>
                    <div class="footer-legal">
                        <p>Mentions légales</p>
                        <p>Politique de confidentialité</p>
                    </div>
                </div>
            </div>
        </footer>
            {% endblock %}

    </body>
</html>
