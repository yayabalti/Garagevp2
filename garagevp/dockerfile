FROM php:8.2-fpm-alpine

# Installation des dépendances
RUN apk update && apk add --no-cache \
    postgresql-dev \
    icu-dev \
    libxml2-dev \
    $PHPIZE_DEPS \
    git \
    unzip \
    zip \
    npm \
    shadow # Ajout de shadow pour usermod

# Configuration et installation des extensions PHP
RUN docker-php-ext-configure pgsql \
    && docker-php-ext-install -j$(nproc) \
    intl \
    pdo \
    pdo_pgsql \
    && docker-php-ext-enable pdo_pgsql

# Installation de Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Création du dossier de travail
WORKDIR /var/www/html

# Création des dossiers var avec les bonnes permissions
RUN mkdir -p /var/www/html/var/cache /var/www/html/var/log \
    && chown -R www-data:www-data /var/www/html

# Copie des fichiers du projet
COPY --chown=www-data:www-data . .

# Configuration de git
RUN git config --global --add safe.directory '*'

# Passer à l'utilisateur www-data pour l'installation de Composer
USER www-data

# Installation des dépendances avec Composer
RUN composer install --optimize-autoloader --no-scripts

# S'assurer que les permissions sont correctes pour var
RUN chmod -R 777 var

EXPOSE 9000

# Copier et configurer le script d'entrée
COPY docker-entrypoint.sh /usr/local/bin/
USER root
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
USER www-data

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["php-fpm"]





