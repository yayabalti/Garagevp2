FROM php:8.2-fpm-alpine

# Installer les dépendances nécessaires
RUN apk add --no-cache nginx curl bash \
    postgresql-dev icu-dev libxml2-dev $PHPIZE_DEPS git unzip zip npm shadow dos2unix

# Installer les extensions PHP nécessaires à Symfony
RUN docker-php-ext-install intl pdo

# Préparer NGINX
COPY /garagevp/docker/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf
RUN chmod 644 /etc/nginx/conf.d/default.conf
COPY /garagevp/docker/nginx/nginx.conf /etc/nginx/nginx.conf

# Modifier PHP-FPM pour écouter sur toutes les interfaces
RUN sed -i 's|listen = 127.0.0.1:9000|listen = 0.0.0.0:9000|' /usr/local/etc/php-fpm.d/www.conf

# Copier le script de démarrage
COPY start.sh /start.sh
RUN chmod +x /start.sh

# Copier l'application Symfony
WORKDIR /var/www/html
COPY . .

# Installer Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer
RUN composer install --no-interaction --prefer-dist --optimize-autoloader

# Exécuter les migrations (si besoin au premier déploiement) 
RUN php bin/console doctrine:migrations:migrate --no-interaction

# Optionnel : charger les fixtures une seule fois (à désactiver après 1er déploiement)
RUN php bin/console doctrine:fixtures:load --no-interaction

# Exposer le port HTTP
ENV PORT=8080
EXPOSE ${PORT}

# Commande de démarrage
CMD ["/start.sh"]




















 










