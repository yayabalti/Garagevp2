;________________________ Version avec render integrer _________________________________________________

###> Application Configuration ###
APP_ENV=dev
APP_DEBUG=0
APP_SECRET=e73ec45580c5b9c19208fa3d19f9215a

# URL de l'application en production
APP_URL=https://garagevp2.onrender.com



###> Symfony Trusted Proxy/Host ###
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR,0.0.0.0/0
TRUSTED_HOSTS=localhost,127.0.0.1,garagevp2.onrender.com
###< Symfony Trusted Proxy/Host ###

###> Messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

###> Mail ###
MAILER_DSN=null://null

###> Firebase ###
FIREBASE_CREDENTIALS_PATH=%kernel.project_dir%/firebase/service-account.json

###> CORS ###
# Autoriser uniquement ton domaine Render
CORS_ALLOW_ORIGIN='^https://(garagevp2\.onrender\.com)$'

###> JWT Auth ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=2fbaedd838744b709d49988537236338cda2d68daebe2ba0a87374fedafe81a6
###< JWT Auth ###

